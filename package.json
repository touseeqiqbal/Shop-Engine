{
  "name": "shopengine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed:bundle": "esbuild prisma/seed.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/seed.mjs --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "payload": "payload",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:types": "payload generate:types && payload generate:importmap",
    "migrate:backup": "bash scripts/migrate/backup-before-migration.sh",
    "migrate:data": "node --conditions=react-server node_modules/payload/bin.js run scripts/migrate/prisma-to-payload.ts",
    "migrate:report": "node --conditions=react-server node_modules/payload/bin.js run scripts/migrate/prisma-to-payload.ts -- --report-only",
    "migrate:fingerprint": "node scripts/migrate/fingerprint-legacy.mjs",
    "stats:recompute": "node --conditions=react-server node_modules/payload/bin.js run scripts/maintenance/recompute-product-stats.ts --",
    "customers:link": "node --conditions=react-server node_modules/payload/bin.js run scripts/maintenance/link-order-customers.ts --",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:urls": "node scripts/migrate/url-check.mjs compare http://localhost:3000 docs/payload-migration/url-baseline.json",
    "db:local": "node scripts/dev-db.mjs",
    "build:tools": "node scripts/build-console-tools.mjs",
    "test:stock": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/stock-race.ts",
    "test:tenants": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/tenant-isolation.ts",
    "test:orders": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/order-lifecycle.ts",
    "test:webhooks": "node scripts/tests/payment-webhooks.mjs",
    "test:billing": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/billing-lifecycle.ts",
    "test:store-webhooks": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/store-webhooks.ts",
    "test:shipments": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/shipments.ts",
    "test:international": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/international.ts",
    "test:integration-payments": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/integration-payments.ts",
    "test:platform-ops": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/platform-ops.ts",
    "test:gift-cards": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/gift-cards.ts",
    "test:preorders": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/preorders.ts",
    "test:unsubscribe": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/unsubscribe.ts",
    "test:stock-value": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/stock-value.ts",
    "test:loyalty": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/loyalty.ts",
    "test:shop-funnel": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/shop-funnel.ts",
    "test:versions": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/versions-access.ts",
    "test:digital": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/digital.ts",
    "test:account-security": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/account-security.ts",
    "test:payment-integrity": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/payment-integrity.ts",
    "test:courier-sync": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/courier-sync.ts",
    "test:pos-payments": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/pos-payments.ts",
    "test:e2e:seed": "node --conditions=react-server node_modules/payload/bin.js run scripts/tests/e2e-seed.ts",
    "test:e2e": "node scripts/tests/e2e-checkout.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:security": "node scripts/tests/security-sweep.mjs",
    "test:crawl": "node scripts/tests/crawl.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-import-export": "^3.90.2",
    "@payloadcms/plugin-redirects": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.4.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "dotenv": "^18.0.5",
    "framer-motion": "^14.0.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.15",
    "payload": "^3.90.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "undici": "^7.30.0",
    "mysql2": "^3.24.5",
    "dompurify": "^3.4.16"
  }
}
