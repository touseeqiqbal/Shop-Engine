# ─────────────────────────────────────────────────────────────────────────────
# Urko Tech Store – environment variables
# Copy to `.env` (or `.env.local`) for local development; set the same keys as
# service variables on Railway for production.
#
# Every variable is optional locally: with no DATABASE_URL the store runs in
# DEMO MODE on the in-memory seed catalog (src/lib/data/seed) and stores
# uploads in .data/uploads/.
# NEXT_PUBLIC_* values are exposed to the browser – never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL – the shop's data lives in Payload's "payload" schema) ─
# Local: `npm run db:local` starts a Postgres and adds DATABASE_URL here for you
#   (or docker compose up -d → postgresql://urko:urko@localhost:5432/urko_tech_store)
# Railway: reference the Postgres service → ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Railway build only: the database's PUBLIC url (the private network isn't reachable during builds)
# → ${{Postgres.DATABASE_PUBLIC_URL}}. Together with PAYLOAD_SECRET the build applies the database
# changes (payload migrate) and pre-renders pages with real data. Never copied into the image.
DATABASE_BUILD_URL=
# Database connections per server (default 10; 2 during the build). Raise only with a bigger Postgres plan –
# every copy of the site opens this many.
DB_POOL_MAX=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash (canonical tags, sitemap, OG, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Secret for signing session tokens & the demo-admin cookie. Generate with
#   npx auth secret     or     openssl rand -base64 32
AUTH_SECRET=
# Trust the X-Forwarded-* headers set by Railway / Cloudflare (required behind a proxy).
AUTH_TRUST_HOST=true
# Public base URL of the site, e.g. https://urkotechstore.com (optional locally).
AUTH_URL=

# Legacy (old Prisma tables, before the move to Payload) – only used by `npm run db:seed`.
# Not needed for a new setup: the first account created at /cms becomes the Owner.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Object storage (Railway Storage Bucket / any S3-compatible bucket) ───────
# The bucket stays PRIVATE; images are served through the app's /media/* route.
# Leave empty locally to store uploads in .data/uploads/.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# "true" for path-style URLs (https://endpoint/bucket/key) – needed by MinIO and some providers.
S3_FORCE_PATH_STYLE=false

# ── Email (order emails, password resets, email confirmation) ────────────────
# Option A – SMTP (used whenever SMTP_HOST is set): any mailbox provider.
#   Google Workspace / Gmail: smtp.gmail.com, port 587, your address, an App Password.
#   Zoho: smtp.zoho.com (smtppro.zoho.com for paid plans) · Hostinger: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: "true" for SSL (automatic for port 465).
SMTP_SECURE=
# Option B – Resend (used when SMTP_HOST is empty): https://resend.com → API Keys. Verify your domain first.
RESEND_API_KEY=
# Sender shown to customers. With SMTP it must be an address the mailbox may send as.
EMAIL_FROM="Urko Tech Store <info@urkotechstore.com>"
# Inbox that receives new-order and contact-form alerts.
ADMIN_ALERT_EMAIL=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Meta for Developers → WhatsApp → API Setup. Use a permanent System User token.
WHATSAPP_TOKEN=
# The "Phone number ID" (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Names of APPROVED message templates: order confirmation and order status update.
WHATSAPP_TEMPLATE_ORDER=
WHATSAPP_TEMPLATE_STATUS=
# Optional: "find my orders" – sends a customer their order numbers (variables: order numbers, track link).
WHATSAPP_TEMPLATE_ORDER_LOOKUP=
# Template language code, e.g. en, en_US or ur.
WHATSAPP_TEMPLATE_LANG=en

# ── SMS fallback ─────────────────────────────────────────────────────────────
# Optional HTTPS endpoint of an SMS gateway or automation (Zapier / Make / n8n
# webhook). Receives a JSON POST with the phone number and message text.
SMS_WEBHOOK_URL=

# ── Analytics & verification ─────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console "HTML tag" verification – only the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Facebook Business Manager domain verification – only the content="…" value.
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
# Bing Webmaster Tools "meta tag" verification – only the content="…" value (or set it in /cms → SEO settings).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Payload CMS (admin at /cms) ───────────────────────────────────────────────
# Long random string, different per environment, never change it afterwards: openssl rand -base64 48
# Required in production (the server refuses to start without it, and without AUTH_SECRET).
# Railway passes it to the Docker build too (see DATABASE_BUILD_URL).
PAYLOAD_SECRET=
# Emergencies only: "false" stops forcing 2-step verification for owners and managers.
TWO_FACTOR_REQUIRED=
# Developer PCs only: "true" lets a production build run locally without the S3 bucket (files then go to
# .data/uploads). Ignored on Railway – production always needs DATABASE_URL, the secrets and S3_*.
LOCAL_PRODUCTION_TEST=
# Extra web addresses allowed to use /cms (comma-separated, e.g. https://admin.example.com). The site's own
# address (NEXT_PUBLIC_SITE_URL, with and without www) and the Railway domain are always allowed.
PAYLOAD_CSRF_ORIGINS=

# ── Visitor IP (rate limits) ──────────────────────────────────────────────────
# Leave empty on Railway. Behind Cloudflare's proxy (orange cloud) set: cf-connecting-ip
CLIENT_IP_HEADER=

# ── Bot check: Cloudflare Turnstile (optional) ───────────────────────────────
# Set BOTH, then redeploy (the site key is built into the pages). With only one, the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Error monitoring: Sentry (optional) ──────────────────────────────────────
# SENTRY_DSN = server errors; NEXT_PUBLIC_SENTRY_DSN = visitors' browsers (build arg – redeploy after changing).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ── Background jobs (optional – the site runs them itself every few minutes) ─
# Background jobs: with several copies of the site only one runs them at a time (database lock).
# HOUSEKEEPING=off turns them off on this copy.
HOUSEKEEPING=
HOUSEKEEPING_MINUTES=5
# Lets an outside scheduler call POST /api/cron with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── WhatsApp templates for reminders and confirmations (optional) ───────────
# Cash-on-delivery confirmation (variables: name, order number, link) – needed when customers must confirm.
WHATSAPP_TEMPLATE_CONFIRM=
WHATSAPP_TEMPLATE_CART=
WHATSAPP_TEMPLATE_BACK_IN_STOCK=
WHATSAPP_TEMPLATE_PRICE_DROP=

# ── Backup service only (Railway cron – see docs/BACKUP-RESTORE.md) ──────────
# A SEPARATE bucket (ideally another account) for the nightly database dumps, private uploads and weekly photo
# copies. Without these, the website's bucket (S3_*) is used.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
# Postgres major version of your database (pg_dump must match): build variable of the backup service.
PG_MAJOR=17
# Encrypts the database dump and private uploads (AES-256). Long random passphrase – keep a copy OUTSIDE
# Railway (password manager): without it the backups can't be restored.
BACKUP_ENCRYPTION_KEY=
# Ping URL of a "missed run" check (e.g. healthchecks.io, period 1 day) – alerts when a night is skipped.
BACKUP_HEARTBEAT_URL=
# Folder names in the backup bucket (default "backups" → backups/, backups-private/, backups-media/).
BACKUP_PREFIX=
# "false" skips the weekly photo copy; "true" in BACKUP_MEDIA_DAILY copies the photos every night instead.
BACKUP_MEDIA=
BACKUP_MEDIA_DAILY=
# Who is told when a backup fails (email uses SMTP_* or RESEND_API_KEY above) – and/or a webhook.
ALERT_EMAILS=
ALERT_FROM=
ALERT_WEBHOOK_URL=

# ── Uptime monitor service only (Railway – see scripts/uptime/monitor.mjs) ───
# The address to watch; alerts go to ALERT_EMAILS (above) and/or by SMS to ALERT_PHONES (via SMS_WEBHOOK_URL).
SITE_URL=
ALERT_PHONES=
CHECK_SECONDS=60
FAILS_BEFORE_ALERT=2
REMIND_MINUTES=30
TIMEOUT_SECONDS=15

# ── Staging environment only ──────────────────────────────────────────────────
# STAGING=true → Basic Auth on every page/API (except /api/health), noindex everywhere,
# robots.txt disallows all, and all customer/admin notifications are suppressed.
# Must be set at build time too (Dockerfile build arg).
STAGING=
STAGING_USER=
STAGING_PASSWORD=
